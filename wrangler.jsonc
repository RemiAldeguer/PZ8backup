{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planzone8-demo",
  "main": "cloudflare/oidc.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
